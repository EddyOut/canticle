{
  "name": "canticle-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:licenses": "pnpm licenses list --json | node tools/repo-checks/src/cli.ts licenses",
    "check:boundaries": "pnpm -r ls --json --depth -1 | node tools/repo-checks/src/cli.ts boundaries",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:licenses && pnpm check:boundaries"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
